# Copy to .env (git-ignored) and fill in real values.
OPENAI_API_KEY=your-openai-api-key

# Optional overrides (defaults live in src/rag/config.py)
# RAG_DATA_DIR=~/Projects/ionos-docs
# RAG_CHROMA_DIR=~/Projects/ionos-docs/chroma
# RAG_EMBEDDING_MODEL=text-embedding-3-small

# Langfuse tracing (optional; without these keys tracing is off)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Retrieval and generation settings (defaults in src/rag/config.py)
# RAG_RETRIEVAL_MODE=vector
# RAG_TOP_K=5
# RAG_LLM_MODEL=gpt-5.4-mini
# RAG_PROMPT_VERSION=v1

# Browser origins allowed to call the API (comma separated)
# RAG_CORS_ORIGINS=http://localhost:5180
